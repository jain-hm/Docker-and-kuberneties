        <mxCell id="b29PODVYWGf21-ZtZ7_U-72" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;1. Client → NodeIP:80&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;2. Packet enters host via eth0 (or ens5 interface.)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;3. IPVS (virtual Server, kernal level LB,distributes traffic)sees published port&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;4. IPVS selects a service task&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;5. Destination IP = overlay VIP / task IP&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;6. Kernel routing lookup:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → route via docker_gwbridge&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;7. Packet crosses docker_gwbridge ( Host &amp;lt;-&amp;gt; swarm network )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;8. Packet enters ingress overlay n/w (VXLAN), Kind of a virtual network/tunnel across nodes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;9. Packet travels to target node&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;10. Packet delivered to container veth&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="670" x="-770" y="911.25" as="geometry" />
        </mxCell>
        <mxCell id="b29PODVYWGf21-ZtZ7_U-75" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Single Host services deployment&lt;/font&gt;" vertex="1">
